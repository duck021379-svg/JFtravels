    <script>
        function playFeaturedVideo() {
            const container = document.getElementById('main-video-container');
            container.innerHTML = `
                <div class="aspect-video w-full">
                    <iframe 
                        width="100%" 
                        height="100%" 
                        src="https://www.youtube.com/embed/sSylxrcMZWw?autoplay=1" 
                        title="Abandoned Funeral Home: Human Remains Found" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                        allowfullscreen
