            </div>
        </section>

        <section id="connect">
            <h2 class="horror-font text-4xl text-center mb-10 text-gray-200">Connect With James</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">

                <a href="https://www.youtube.com/@jftravels412" target="_blank" rel="noopener noreferrer" class="social-card p-8 rounded-xl text-center group">
                    <i class="fab fa-youtube text-3xl mb-3 text-red-600 group-hover:scale-110 transition"></i>
