            <div class="flex gap-6">
                <a href="#investigations" class="text-xs font-bold uppercase tracking-wider hover:text-red-500 transition">Investigations</a>
                <a href="#shorts" class="text-xs font-bold uppercase tracking-wider hover:text-red-500 transition">Shorts</a>
                <a href="#connect" class="text-xs font-bold uppercase tracking-wider hover:text-red-500 transition">Socials</a>
