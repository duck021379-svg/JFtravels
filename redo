<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JF Travels | Haunted Investigations & Urban Exploration</title>
    
    <!-- SEO & Social Sharing (Open Graph) Meta Tags -->
    <meta name="description" content="Join James on JF Travels for paranormal explorations, haunted investigations, and chilling urban decay across Pennsylvania and beyond.">
    <meta property="og:title" content="JF Travels | Haunted Investigations">
    <meta property="og:description" content="Paranormal Exploration & Urban Decay. Watch the latest investigations from Savagio Funeral Home and Cresson Sanatorium.">
    <meta property="og:image" content="https://img.youtube.com/vi/sSylxrcMZWw/maxresdefault.jpg">
    <meta property="og:type" content="website">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Montserrat:wght@300;400;600;700&display=swap');

        :root {
            --haunted-red: #8b0000;
            --ghost-grey: #1a1a1a;
            --void-black: #050505;
        }

        body {
            background-color: var(--void-black);
            color: #d1d1d1;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        .horror-font {
            font-family: 'Creepster', cursive;
            letter-spacing: 2px;
        }

        .hero-section {
            background: linear-gradient(to bottom, rgba(5, 5, 5, 0.5), rgba(5, 5, 5, 1)), 
                        url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=2069&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            min-height: 65vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        .video-portal {
            background: #111;
            border: 1px solid rgba(139, 0, 0, 0.4);
            border-radius: 16px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.9);
        }

        .video-thumbnail {
            width: 100%;
            aspect-ratio: 16/9;
            background-image: url('https://img.youtube.com/vi/sSylxrcMZWw/maxresdefault.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.5s;
        }

        .video-thumbnail:hover {
            filter: brightness(1.15) saturate(1.2);
        }

        .short-portal {
            width: 100%;
            max-width: 340px;
            aspect-ratio: 9/16;
            background: #0a0a0a;
            border: 1px solid rgba(139, 0, 0, 0.5);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 0 35px rgba(139, 0, 0, 0.25);
        }

        .play-button {
            width: 80px;
            height: 80px;
            background: rgba(139, 0, 0, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            box-shadow: 0 0 20px rgba(139, 0, 0, 0.8);
            animation: pulse-red 2s infinite;
        }

        @keyframes pulse-red {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(139, 0, 0, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(139, 0, 0, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(139, 0, 0, 0); }
        }

        .btn-blood {
            background-color: var(--haunted-red);
            transition: 0.3s;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .btn-blood:hover {
            background-color: #b30000;
            box-shadow: 0 0 20px rgba(139, 0, 0, 0.6);
        }

        .social-card {
            background: #0d0d0d;
            border: 1px solid #1a1a1a;
            transition: 0.3s;
        }

        .social-card:hover {
            border-color: var(--haunted-red);
            background: #141414;
            transform: translateY(-3px);
        }
    </style>
</head>
<body>

    <nav class="fixed w-full z-50 bg-black/85 backdrop-blur-md border-b border-red-900/20 px-4 py-3">
